#!/usr/bin/env bash
# Blocks commits that include a .env file or something shaped like an API key.
staged=$(git diff --cached --name-only)
if echo "$staged" | grep -E '(^|/)\.env(\..*)?$' | grep -vE '(^|/)\.env\.example$' > /dev/null; then
  echo "Commit blocked: a .env file is staged. Unstage it with: git rm --cached <file>"
  exit 1
fi
if git diff --cached -U0 | grep -E '^\+' | grep -E 'AQ\.[A-Za-z0-9_-]{30,}|AIza[0-9A-Za-z_-]{35}' > /dev/null; then
  echo "Commit blocked: staged changes contain something that looks like an API key."
  exit 1
fi
exit 0
